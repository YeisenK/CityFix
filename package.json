{
  "name": "cityfix",
  "private": true,
  "workspaces": [
    "shared",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cityfix/backend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @cityfix/backend",
    "db:seed": "npm run db:seed --workspace @cityfix/backend"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}